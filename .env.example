# Campaign OS — Door Knock
# Copy to .env.local for development; set these in the Vercel project too.

# Supabase (NEXT_PUBLIC_* are exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1Ijoi...
MAPBOX_SECRET_TOKEN=sk.eyJ1Ijoi...

# Airtable (fallback PAT; used if no per-client OAuth/PAT is stored)
AIRTABLE_API_KEY=patXXXXXXXXXX

# Airtable OAuth — register an app at https://airtable.com/create/oauth
# Redirect URI must match exactly (no wildcards). Use the apex domain; the
# callback handler then forwards the browser back to the client's subdomain.
AIRTABLE_OAUTH_CLIENT_ID=
AIRTABLE_OAUTH_CLIENT_SECRET=
AIRTABLE_OAUTH_REDIRECT_URI=https://your-apex.vercel.app/api/airtable/oauth/callback

# Secret used to HMAC-sign the OAuth state param. Any ≥32 char random string.
# Falls back to SUPABASE_SERVICE_ROLE_KEY if unset, but a dedicated secret is
# preferred so rotating Supabase keys doesn't invalidate in-flight OAuth flows.
APP_SECRET=

# Anthropic (Claude) — used for AI-assisted Airtable schema mapping
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXX

# Email / invites (Resend)
RESEND_API_KEY=re_XXXXXXXXXX

# n8n ↔ Next bridge (optional)
N8N_WEBHOOK_SECRET=

# Optional — used by invite emails + CSP
NEXT_PUBLIC_APP_URL=http://localhost:3000
