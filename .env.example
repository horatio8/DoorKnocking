# Campaign OS — Door Knock
# Copy to .env.local for development; set these in the Vercel project too.

# Supabase (NEXT_PUBLIC_* are exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1Ijoi...
MAPBOX_SECRET_TOKEN=sk.eyJ1Ijoi...

# Airtable
AIRTABLE_API_KEY=patXXXXXXXXXX

# Email / invites (Resend)
RESEND_API_KEY=re_XXXXXXXXXX

# n8n ↔ Next bridge (optional)
N8N_WEBHOOK_SECRET=

# Optional — used by invite emails + CSP
NEXT_PUBLIC_APP_URL=http://localhost:3000
